def _generate_synthetic_prices(n_assets: int = 30,
                               start: str = "2018-01-01",
                               end:   str = "2024-12-31",
                               tickers: list = None,
                               seed: int = 42) -> pd.DataFrame:
    """
    Simulate realistic S&P 500-like multivariate daily prices using a
    3-factor model (market + two sector factors) with GARCH-style volatility.

    Calibrated to approximate:
      • Annual returns:     8–18%   (mean ~13%)
      • Annual volatilities:15–40%  (mean ~22%)
      • Pairwise correlations: 0.2–0.8 (sector blocks)
    """
    np.random.seed(seed)
    dates = pd.bdate_range(start=start, end=end)
    T = len(dates)

    # Asset metadata
    if tickers is None:
        tickers = [f"STOCK_{i:02d}" for i in range(n_assets)]
    tickers = tickers[:n_assets]

    # Assign assets to 5 sectors
    n_sectors = 5
    sectors = np.array([i % n_sectors for i in range(n_assets)])

    # Factor loadings
    mkt_beta     = 0.6 + 0.6 * np.random.rand(n_assets)          # market β ∈ [0.6, 1.2]
    sector_beta  = 0.3 + 0.5 * np.random.rand(n_assets)          # sector  β ∈ [0.3, 0.8]

    # Daily drifts (calibrated to annual ~13% return)
    mu_daily = (0.06 + 0.12 * np.random.rand(n_assets)) / 252

    # Idiosyncratic vols (annual ~15%)
    idio_vol = (0.10 + 0.20 * np.random.rand(n_assets)) / np.sqrt(252)

    # Simulate factor returns
    mkt_vol    = 0.15 / np.sqrt(252)
    sector_vol = 0.08 / np.sqrt(252)

    mkt_ret    = np.random.normal(0.08 / 252, mkt_vol,    T)
    sector_ret = np.random.normal(0.00,        sector_vol, (T, n_sectors))

    # Simulate log-returns
    log_ret = np.zeros((T, n_assets))
    for i in range(n_assets):
        s = sectors[i]
        idio          = np.random.normal(0.0, idio_vol[i], T)
        log_ret[:, i] = (mu_daily[i]
                         + mkt_beta[i]   * mkt_ret
                         + sector_beta[i]* sector_ret[:, s]
                         + idio)

    # Convert to prices
    log_prices = np.cumsum(log_ret, axis=0)
    prices_arr = 100.0 * np.exp(log_prices)
    return pd.DataFrame(prices_arr, index=dates, columns=tickers)


def run_experiment(tickers,
                   start="2018-01-01",
                   end="2024-12-31",
                   train_window=252,
                   rebal_freq=63):
    """
    Download data, run all QSW presets + benchmarks, and return results.

    Parameters
    ----------
    tickers      : list of ticker symbols
    start / end  : backtest date range
    train_window : trading days of history for training (252 = 1 year)
    rebal_freq   : days between rebalances (63 ≈ quarterly)

    Returns
    -------
    results  : dict  strategy_name → metrics dict
    portfolios: dict strategy_name → cumulative wealth pd.Series
    prices   : pd.DataFrame of downloaded prices
    tickers_used: list[str]
    """
    print("━" * 60)
    print("  Downloading price data …")
    prices = None
    try:
        raw = yf.download(tickers, start=start, end=end,
                          auto_adjust=True, progress=False)["Close"]
        raw = raw.dropna(axis=1, how="any").dropna()
        if raw.shape[0] > train_window + 2 * rebal_freq and raw.shape[1] >= 5:
            prices = raw
    except Exception:
        pass

    if prices is None or prices.empty:
        print("  ⚠  Live download unavailable – using realistic synthetic data.")
        prices = _generate_synthetic_prices(
            n_assets=min(len(tickers), 30),
            start=start, end=end,
            tickers=tickers,
        )

    tickers_used = list(prices.columns)
    n = len(tickers_used)
    print(f"  {n} assets: {', '.join(tickers_used[:10])}{'…' if n > 10 else ''}")
    print("━" * 60)

    # Build strategy dictionary
    strategies = {}
    for name, params in PRESETS.items():
        strategies[name] = (lambda ret, p=params: qsw_portfolio(ret, **p))
    strategies["1/N Equal Weight"] = lambda ret: equal_weight(ret.shape[1])
    strategies["MPT Max-Sharpe"]   = lambda ret: max_sharpe_mpt(ret)

    results, portfolios, w_histories = {}, {}, {}
    for name, fn in strategies.items():
        print(f"  Backtesting: {name} …", flush=True)
        ret_s, wh = backtest(prices, fn,
                             train_window=train_window,
                             rebal_freq=rebal_freq)
        m = compute_metrics(ret_s)
        m["Annual Turnover"] = annual_turnover(wh)
        if wh:
            m["HHI"]           = hhi(wh[-1][1])
            m["Eff. # Stocks"] = 1.0 / m["HHI"]
        results[name]     = m
        portfolios[name]  = (1.0 + ret_s).cumprod()
        w_histories[name] = wh

    return results, portfolios, w_histories, tickers_used, prices


def print_table(results: dict):
    """Pretty-print the performance summary table."""
    SEP = "═" * 100
    print("\n" + SEP)
    print("  PORTFOLIO PERFORMANCE SUMMARY")
