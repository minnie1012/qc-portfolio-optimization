# ─────────────────────────────────────────────────────────────────────────────
# SECTION 1 – FINANCIAL FEATURE EXTRACTION
# ─────────────────────────────────────────────────────────────────────────────

def compute_financial_features(returns: pd.DataFrame):
    """
    Compute daily Sharpe ratios, covariance, and correlation from a
    returns DataFrame (rows = dates, columns = assets).
    """
    mu = returns.mean()                   # daily mean return
    sigma = returns.std().replace(0, 1e-12)
    sharpe_daily = mu / sigma             # daily Sharpe ratio
    cov = returns.cov()
    corr = returns.corr()
    return mu, sigma, sharpe_daily, cov, corr


# ─────────────────────────────────────────────────────────────────────────────
# SECTION 2 – GRAPH CONSTRUCTION
# ─────────────────────────────────────────────────────────────────────────────

def build_hamiltonian(sharpe: pd.Series, corr: pd.DataFrame,
                      alpha: float = 10.0, beta: float = 10.0) -> np.ndarray:
    """
    Build the Hermitian Hamiltonian H for the QSW.

    Diagonal (self-loops):  H_ii = α · SR_i  (Sharpe information)
    Off-diagonal (edges):   H_ij = β · (1 − |ρ_ij|)  (correlation penalty)

    A larger edge weight between assets i and j means the walk
    favours moving from a highly-correlated neighbour to a
    less-correlated one (diversification incentive).
    """
    sr = sharpe.values.astype(float)
    # Normalise Sharpe ratios to [0, 1] for numerical stability
    sr_range = sr.max() - sr.min()
    sr_norm = (sr - sr.min()) / sr_range if sr_range > 1e-10 else np.ones_like(sr) / len(sr)

    n = len(sr)
    corr_arr = corr.values.astype(float)

    H = beta * (1.0 - np.abs(corr_arr))   # off-diagonal correlation penalty
    np.fill_diagonal(H, alpha * sr_norm)  # diagonal Sharpe self-loops

    return H  # real symmetric → Hermitian


def build_weight_matrix(
    SR: np.ndarray,
    Sigma: np.ndarray,
    alpha: float = 1.0,
    beta: float = 1.0,
    lam: float = 1.0,
) -> np.ndarray:
    """
    Build the weight matrix W defined by:

        W_ij = exp(alpha * SR_j  -  beta * Sigma_ij)   if i != j
        W_ii = exp(lam   * SR_i)                        if i == j

    Parameters
    ----------
    SR    : (n,) array of Sharpe ratios, one per asset
    Sigma : (n, n) covariance matrix
    alpha : scaling factor for SR_j in off-diagonal entries
    beta  : scaling factor for Sigma_ij in off-diagonal entries
    lam   : scaling factor for SR_i on diagonal entries

    Returns
    -------
    W : (n, n) weight matrix
    """
    SR = np.asarray(SR, dtype=float)
    Sigma = np.asarray(Sigma, dtype=float)
    # Off-diagonal formula applied to every entry first, then overwrite diagonal
    W = np.exp(alpha * SR[np.newaxis, :] - beta * Sigma)
    np.fill_diagonal(W, np.exp(lam * SR))
    return W


def build_google_matrix(corr: pd.DataFrame, lam: float = 10.0) -> np.ndarray:
    """
    Build the column-stochastic Google transition matrix G.

    Step 1 – Base adjacency A:
        A_ij = 1 − |corr_ij|  (i ≠ j)  — favours low-correlation transitions
        A_ii = 0
    Step 2 – Column-normalise A to obtain a Markov chain A_norm.
    Step 3 – Mix with uniform teleportation:
        d   = λ / (λ + 1)          (teleportation damping factor)
        G   = (1 − d) · A_norm  +  d · J / n
    where J is the n×n all-ones matrix and n is the number of assets.

    Effect of λ:
      λ → 0  : walk is entirely graph-based (follows correlation structure)
      λ → ∞  : walk is entirely uniform (equal-weight transitions → 1/N)
    """
    n = corr.shape[0]
    corr_arr = corr.values.astype(float)

    # Base adjacency: penalise correlated pairs
    A = np.maximum(1.0 - np.abs(corr_arr), 0.0)
    np.fill_diagonal(A, 0.0)

    # Column-normalise
    col_sums = A.sum(axis=0)
    col_sums[col_sums < 1e-12] = 1.0       # guard against zero columns
    A_norm = A / col_sums[np.newaxis, :]

    # Teleportation mixing
    d = lam / (lam + 1.0)
    G = (1.0 - d) * A_norm + d * np.ones((n, n)) / n
    return G                               # each column sums to 1


# ─────────────────────────────────────────────────────────────────────────────
# SECTION 3 – LINDBLAD SUPEROPERATOR (GKLS)
# ─────────────────────────────────────────────────────────────────────────────

def build_lindblad_superoperator(H: np.ndarray, G: np.ndarray,
                                  omega: float = 0.4) -> np.ndarray:
    """
    Construct the GKLS Lindblad superoperator L_super such that:

        d vec(ρ) / dt  =  L_super · vec(ρ)

    where vec(ρ) is the column-major vectorisation of the density matrix.

    Column-major vectorisation identities used:
        vec(AXB) = (B^T ⊗ A) vec(X)
        vec([H,ρ]) = (I ⊗ H − H^T ⊗ I) vec(ρ)

    Coherent term (unitary, quantum channel):
        −i(1−ω)(I ⊗ H − H^T ⊗ I)

    Dissipative term (classical channel) — SIMPLIFIED for column-stochastic G:
        Since Σ_i G[i,j] = 1 ∀j, the Lindblad dissipator reduces to:
            ω · (Λ_super − I_{n²})
        where Λ_super[k(n+1), j(n+1)] = G[k, j]  (maps diagonal ρ → diagonal Λ(ρ))
    """
    n = H.shape[0]
    n2 = n * n
    I_n = np.eye(n)

    # ── Coherent superoperator ──────────────────────────────────────────────
    L_coherent = -1j * (1.0 - omega) * (np.kron(I_n, H) - np.kron(H.T, I_n))

    # ── Dissipative superoperator (simplified, column-stochastic G) ─────────
    # Λ_super maps diagonal elements of ρ via G:
    #   (Λ(ρ))_kk = Σ_j G[k,j] · ρ_jj
    # In the column-major vector, diagonal element (k,k) is at index k*(n+1).
    Lambda_super = np.zeros((n2, n2), dtype=complex)
    for k in range(n):
        for j in range(n):
            Lambda_super[k * (n + 1), j * (n + 1)] = G[k, j]

    L_dissipative = omega * (Lambda_super - np.eye(n2, dtype=complex))

    return L_coherent + L_dissipative


# ─────────────────────────────────────────────────────────────────────────────
# SECTION 4 – STEADY-STATE EXTRACTION
# ─────────────────────────────────────────────────────────────────────────────

def find_steady_state(L_super: np.ndarray, n: int):
    """
    Solve  L_super · vec(ρ∞) = 0  subject to  Tr(ρ∞) = 1.

    The trace constraint replaces the last equation:
        Σ_k  vec(ρ)[k(n+1)]  =  1

    Returns
    -------
    rho_ss  : complex ndarray of shape (n, n) – steady-state density matrix
    weights : real ndarray of shape (n,)      – portfolio weights = diag(ρ∞)
    """
    n2 = n * n
    mat = L_super.copy()

    # Replace last row with trace-normalisation constraint
    trace_row = np.zeros(n2, dtype=complex)
    for k in range(n):
        trace_row[k * (n + 1)] = 1.0      # column-major diagonal index
    mat[-1, :] = trace_row

    rhs = np.zeros(n2, dtype=complex)
    rhs[-1] = 1.0

    try:
        vec_rho = np.linalg.solve(mat, rhs)
    except np.linalg.LinAlgError:
        vec_rho, *_ = np.linalg.lstsq(mat, rhs, rcond=None)

    # Reshape back to density matrix (column-major)
    rho_ss = vec_rho.reshape((n, n), order="F")

    # Extract diagonal and project onto probability simplex
    weights = np.real(np.diag(rho_ss))
    weights = np.maximum(weights, 0.0)
    total = weights.sum()
    weights /= total if total > 1e-12 else 1.0
    return rho_ss, weights


# ─────────────────────────────────────────────────────────────────────────────
# SECTION 5 – QSW PORTFOLIO OPTIMIZER (ALL-IN-ONE)
# ─────────────────────────────────────────────────────────────────────────────

def qsw_portfolio(returns: pd.DataFrame,
                  alpha: float = 10.0,
                  beta: float  = 10.0,
                  lam:  float  = 10.0,
                  omega: float = 0.4) -> np.ndarray:
    """
    Full QSW pipeline: returns → weights.

    Parameters
    ----------
    returns : pd.DataFrame  (T × n) daily log or simple returns
    alpha   : Sharpe-ratio weight on Hamiltonian self-loops
    beta    : Correlation-penalty weight on Hamiltonian off-diagonal
    lam     : Teleportation strength in Google matrix
    omega   : Quantum–classical mixing parameter ∈ [0, 1]

    Returns
    -------
    weights : np.ndarray of shape (n,)
    """
    n = returns.shape[1]
    _, _, sharpe, _, corr = compute_financial_features(returns)
    H = build_hamiltonian(sharpe, corr, alpha=alpha, beta=beta)
    G = build_google_matrix(corr, lam=lam)
    L_super = build_lindblad_superoperator(H, G, omega=omega)
    _, weights = find_steady_state(L_super, n)
    return weights


# ─────────────────────────────────────────────────────────────────────────────
# SECTION 6 – BENCHMARK PORTFOLIOS
# ─────────────────────────────────────────────────────────────────────────────

def equal_weight(n: int) -> np.ndarray:
    """Naive 1/N equal-weight portfolio."""
    return np.ones(n) / n


def max_sharpe_mpt(returns: pd.DataFrame, rf: float = 0.0) -> np.ndarray:
    """
    Classical Markowitz maximum-Sharpe portfolio (long-only).
    Uses annualised returns and covariances (×252).
    """
    mu  = returns.mean().values * 252
    cov = returns.cov().values  * 252
    n   = len(mu)

    def neg_sharpe(w):
        ret = w @ mu
        vol = np.sqrt(max(w @ cov @ w, 1e-20))
        return -(ret - rf) / vol

    w0 = np.ones(n) / n
    constraints = [{"type": "eq", "fun": lambda w: w.sum() - 1.0}]
    bounds = [(0.0, 1.0)] * n
    res = minimize(neg_sharpe, w0, method="SLSQP",
                   bounds=bounds, constraints=constraints,
                   options={"maxiter": 2000, "ftol": 1e-10})

    w = np.maximum(res.x, 0.0)
    w /= w.sum() if w.sum() > 1e-12 else 1.0
    return w


# ─────────────────────────────────────────────────────────────────────────────
# SECTION 7 – WALK-FORWARD BACKTEST ENGINE
# ─────────────────────────────────────────────────────────────────────────────

def backtest(prices: pd.DataFrame,
             strategy_fn,
             train_window: int = 252,
             rebal_freq:   int = 63) -> tuple:
    """
    Walk-forward backtest with periodic rebalancing.

    Parameters
    ----------
    prices       : pd.DataFrame (T × n) adjusted close prices
    strategy_fn  : callable(returns_train) → np.ndarray of weights
    train_window : number of trading days used to fit the model
    rebal_freq   : number of days between rebalancing events

    Returns
    -------
    port_ret  : pd.Series of daily portfolio returns
    w_history : list of (date, weights) tuples at each rebalancing event
    """
    returns = prices.pct_change().dropna()
    n = prices.shape[1]
    current_w = np.ones(n) / n
    w_history, daily_returns = [], []

    dates = returns.index
    for t in range(train_window, len(dates)):
        # Rebalance?
        if (t - train_window) % rebal_freq == 0:
            train_ret = returns.iloc[t - train_window : t]
            try:
                current_w = strategy_fn(train_ret)
            except Exception:
                current_w = np.ones(n) / n
            w_history.append((dates[t], current_w.copy()))

        day_ret = float((returns.iloc[t].values * current_w).sum())
        daily_returns.append((dates[t], day_ret))

    port_ret = pd.Series(
        [r for _, r in daily_returns],
        index=[d for d, _ in daily_returns],
        name="return",
    )
    return port_ret, w_history


# ─────────────────────────────────────────────────────────────────────────────
# SECTION 8 – PERFORMANCE METRICS
# ─────────────────────────────────────────────────────────────────────────────

def compute_metrics(ret: pd.Series, rf: float = 0.0) -> dict:
    """Compute annualised risk/return/drawdown metrics."""
    ann_ret = ret.mean() * 252
    ann_vol = ret.std() * np.sqrt(252)
    sharpe  = (ann_ret - rf) / max(ann_vol, 1e-12)
    cum     = (1.0 + ret).cumprod()
    mdd     = ((cum - cum.cummax()) / cum.cummax()).min()
    return {
        "Annualised Return":    ann_ret,
        "Annualised Volatility": ann_vol,
        "Sharpe Ratio":          sharpe,
        "Max Drawdown":          mdd,
        "Final Wealth":          cum.iloc[-1],
    }


def hhi(weights: np.ndarray) -> float:
    """Herfindahl–Hirschman Index (portfolio concentration). 1/n = max diversity."""
    return float(np.sum(weights ** 2))


def annual_turnover(w_history: list, periods_per_year: float = 4.0) -> float:
    """Average annual one-way portfolio turnover from rebalancing history."""
    if len(w_history) < 2:
        return 0.0
    tos = [0.5 * np.abs(w_history[i][1] - w_history[i-1][1]).sum()
           for i in range(1, len(w_history))]
    return float(np.mean(tos) * periods_per_year)


