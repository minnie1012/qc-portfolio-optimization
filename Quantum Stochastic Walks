    print(hdr)
    print("─" * 100)
    for name, m in results.items():
        print(
            f"  {name:<26}  "
            f"{m['Sharpe Ratio']:>7.3f}  "
            f"{m['Annualised Return']*100:>9.2f}  "
            f"{m['Annualised Volatility']*100:>9.2f}  "
